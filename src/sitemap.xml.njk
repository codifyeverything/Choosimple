---
permalink: /sitemap.xml
layout: false
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/</loc>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ site.url }}/index.html</loc>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ site.url }}/all-decisions.html</loc>
    <priority>0.9</priority>
  </url>
  {% for group in site.categoryGroups %}
  <url>
    <loc>{{ site.url }}{{ group.url }}</loc>
    <priority>0.9</priority>
  </url>
  {% endfor %}
  {% for item in categories %}
  <url>
    <loc>{{ site.url }}{{ item.url }}</loc>
    <priority>0.8</priority>
  </url>
  {% endfor %}
  <url>
    <loc>{{ site.url }}/about.html</loc>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>{{ site.url }}/disclosure.html</loc>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>{{ site.url }}/privacy.html</loc>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>{{ site.url }}/contact.html</loc>
    <priority>0.5</priority>
  </url>
</urlset>
