<a class="dec-card-new dec-card-new--lifestyle" href="{{ item.url }}">
  <div class="dec-card-img dec-card-img--lifestyle">
    <img alt="{{ item.imageAlt }}" src="{{ item.image }}"/>
  </div>
  <div class="dec-card-body">
    <p class="dec-card-cat">{{ item.group }}</p>
    <p class="dec-card-kicker">Choosimple decision</p>
    <h3 class="dec-card-title">{{ item.cardTitle }}</h3>
    <p class="dec-card-pick">{{ item.decision }}</p>
    <p class="dec-card-summary">{{ item.summary }}</p>
    <p class="dec-card-proofline"><strong>Why it wins:</strong> {{ item.proof }}</p>
    <p class="dec-card-price">{{ item.price }}</p>
    <div class="dec-card-footer">
      <span class="dec-card-link">See why this one wins <span>→</span></span>
    </div>
  </div>
</a>
