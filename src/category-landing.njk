---
layout: base.njk
pagination:
  data: site.categoryGroups
  size: 1
  alias: group
permalink: "{{ group.url }}"
eleventyComputed:
  title: "{{ group.title }} Decisions | Choosimple"
  description: "{{ group.description }}"
---

{% set groupItems = categories | groupItems(group) %}

<section class="category-landing-hero">
  <div class="category-landing-hero-inner">
    <a class="page-breadcrumb" href="/index.html">Choosimple / Decision Areas</a>
    <span class="eyebrow">{{ group.eyebrow }}</span>
    <h1>{{ group.title }} decisions.</h1>
    <p>{{ group.description }}</p>
    <div class="category-landing-meta">
      <span>{{ groupItems.length }} current decisions</span>
      <span>One clear pick per category</span>
    </div>
  </div>
</section>

<section class="category-landing-list">
  <div class="category-landing-list-inner">
    <div class="catalogue-header catalogue-header--compact">
      <div class="catalogue-header-left">
        <span class="eyebrow">Browse {{ group.title }}</span>
        <h2>Every {{ group.title | lower }} pick in one place.</h2>
      </div>
      <div class="catalogue-header-right">
        <p>Use this page as the full hub for this decision area. The homepage can stay clean while the library keeps growing.</p>
      </div>
    </div>

    <div class="card-grid">
      {% for item in groupItems %}
      {% include "category-card.njk" %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="category-landing-note">
  <div class="category-landing-note-inner">
    <span class="eyebrow">How Choosimple decides</span>
    <h2>Not every good product becomes the decision.</h2>
    <p>Each category is built around the product that makes the strongest overall case for reliability, performance, ease of use, maintenance, and value. Alternatives can still be good — they just need a clearer reason to beat the main decision.</p>
    <a class="btn btn-outline" href="/all-decisions.html">View all decision areas</a>
  </div>
</section>
