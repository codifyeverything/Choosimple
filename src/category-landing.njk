---
layout: base.njk
pagination:
  data: site.categoryGroups
  size: 1
  alias: group
permalink: "{{ group.url }}"
eleventyComputed:
  title: "{{ group.title }} Decisions | Choosimple"
  description: "{{ group.description }}"
---

{% set groupItems = categories | groupItems(group) %}

<section class="category-landing-hero">
  <div class="category-landing-hero-inner">
    <a class="page-breadcrumb" href="/">Choosimple / {{ group.title }}</a>
    <h1>{{ group.title }} decisions</h1>
    <p>{{ group.description }}</p>
  </div>
</section>

<section class="category-landing-list">
  <div class="category-landing-list-inner">
    <div class="card-grid">
      {% for item in groupItems %}
      {% include "category-card.njk" %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="category-landing-note">
  <div class="category-landing-note-inner">
    <span class="eyebrow">How Choosimple chooses</span>
    <h2>Useful beats flashy</h2>
    <p>Each guide weighs reliability, performance, ease of use, maintenance, and value. The decision goes to the product that makes the strongest overall case for most buyers.</p>
    <a class="btn btn-outline" href="/all-decisions.html">View all decisions</a>
  </div>
</section>
