<span class="quick-shop-label">Kitchen</span>
<strong class="quick-shop-products">Blender, air fryer, coffee grinder</strong>
<span>See kitchen picks →</span>
</a>
<a class="quick-shop-card" href="#home-cat">
<span class="quick-shop-label">Home Essentials</span>
<strong class="quick-shop-products">Robot vacuum, air purifier, video doorbell</strong>
<span>See home picks →</span>
</a>
<a class="quick-shop-card" href="#personal-care">
<span class="quick-shop-label">Personal Care</span>
<strong class="quick-shop-products">Electric toothbrush, hair straightener</strong>
<span>See personal care picks →</span>
</a>
</div>
</div>
</section><section class="micro-signup" id="email-signup">
<div class="micro-signup-inner">
<div class="micro-signup-copy">
<span class="eyebrow">Get updates</span>
<h2>Still deciding?</h2>
<p>Stay up to date with the latest picks and category launches</p>
</div>
<form action="ACTION-URL-HERE" class="micro-signup-form" method="post" target="_blank">
<input name="EMAIL" placeholder="you@example.com" type="email"/>
<button type="submit">Get updates</button>
</form>
</div>
</section><section class="catalogue" id="catalogue">
<div class="catalogue-header">
<div class="catalogue-header-left">
<span class="eyebrow">Browse by category</span>
<h2>Shop by category.<br/>Get one clear answer.</h2>
</div>
</div>
<section class="mini-how" id="how">
<div class="mini-how-grid">
<div class="mini-how-item">
<span>01</span>
<h3>Start with the decision</h3>
<p>Get the one pick that makes the most sense before spending time on edge cases.</p>
</div>
<div class="mini-how-item">
<span>02</span>
<h3>Use the proof</h3>
<p>See the buyer mistakes, misleading signals, and ownership tradeoffs that support the decision.</p>
</div>
<div class="mini-how-item">
<span>03</span>
<h3>Check the exceptions</h3>
<p>Only look at alternatives if your situation clearly calls for one.</p>
</div>
</div>
</section>
<section class="cat-group" id="kitchen">
<div class="cat-group-header">
<h3>Kitchen</h3>
<span class="cat-group-count">{{ categories | groupCount('Kitchen') }} decisions</span>
</div>
<div class="card-grid">
{% for item in categories %}{% if item.group == "Kitchen" %}
{% include "category-card.njk" %}
{% endif %}{% endfor %}
</div>
</section>
<section class="cat-group" id="home-cat">
<div class="cat-group-header">
<h3>Home Essentials</h3>
<span class="cat-group-count">{{ categories | groupCount('Home Essentials') }} decisions</span>
</div>
<div class="card-grid">
{% for item in categories %}{% if item.group == "Home Essentials" %}
{% include "category-card.njk" %}
{% endif %}{% endfor %}
</div>
</section>
<section class="cat-group" id="personal-care">
<div class="cat-group-header">
<h3>Personal Care</h3>
<span class="cat-group-count">{{ categories | groupCount('Personal Care') }} decisions</span>
</div>
<div class="card-grid">
{% for item in categories %}{% if item.group == "Personal Care" %}
{% include "category-card.njk" %}
{% endif %}{% endfor %}
</div>
</section>
</section>

<script>
(function () {
  const featuredCards = Array.from(document.querySelectorAll(".featured-rotation-card"));

  if (featuredCards.length === 0) {
    return;
  }

  let featuredIndex = featuredCards.findIndex((card) => card.classList.contains("is-active"));

  if (featuredIndex === -1) {
    featuredIndex = 0;
    featuredCards[0].classList.add("is-active");
  }

  if (featuredCards.length < 2) {
    return;
  }

  setInterval(() => {
    featuredCards[featuredIndex].classList.remove("is-active");
    featuredIndex = (featuredIndex + 1) % featuredCards.length;
    featuredCards[featuredIndex].classList.add("is-active");
  }, 3000);
})();
</script>
